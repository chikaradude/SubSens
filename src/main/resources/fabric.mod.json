{
  "schemaVersion": 1,
  "id": "subsense",
  "version": "${version}",
  "name": "SubSense",
  "description": "Allows using even lower sensitivity in Minecraft.",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/subsense/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "pl.panocha.subsense.client.SubSenseDataGenerator"
    ],
    "client": [
      "pl.panocha.subsense.client.SubSenseClient"
    ],
    "main": [
      "pl.panocha.subsense.SubSense"
    ]
  },
  "mixins": [
    "subsense.mixins.json",
    {
      "config": "subsense.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
